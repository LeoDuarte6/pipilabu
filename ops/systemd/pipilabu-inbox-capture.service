[Unit]
Description=Capture authenticated Pipi Labu Gmail and Buzz requests
Wants=network-online.target
After=network-online.target tnb-buzz-inbox.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/leo/.hermes/scripts/pipilabu-inbox-poll.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/home/leo/data/techandbusiness/buzz-inbox
ReadWritePaths=/home/leo/.hermes/pipilabu-intake
