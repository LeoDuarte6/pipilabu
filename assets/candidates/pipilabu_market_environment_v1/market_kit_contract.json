  "purpose": "Reusable compact Japanese market/farmers-market environment pieces that enrich the world around the one-shop service loop without changing gameplay authority.",
  "reference_translation": {
    "accepted": [
      "oversized focal seller versus a small, readable customer line",
      "fruit as the highest-salience handoff prop",
      "canopies, shelves, crates, and signs creating vertical market rhythm",
      "warm rendered caramel, cream, vermilion, wood, and lantern amber roles",
      "grounded stalls with a clear service lane"
    ],
    "contextual": [
      "dense Japanese market/city-village cadence",
      "repeated stall modules with small authored asymmetries",
      "a warm lantern beat at the street edge"
    ],
    "rejected": [
      "pasted video pixels, watermark, logos, skyline, or social UI",
      "prominent upright/top ears as a character or sign silhouette",
      "generic full-town/baseplate sprawl",
      "decorative pieces occupying the handoff corridor",
      "unbounded collision on fruit, fabric stripes, labels, or VFX"
    ]
  },
