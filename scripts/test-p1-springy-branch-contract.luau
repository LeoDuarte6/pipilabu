-- Deterministic contract tests for the disabled-by-default Gate P1 lane.

local P1 = require("../src/shared/P1SpringyBranch")
local Config = require("../src/shared/P1SpringyBranchConfig")

assert(Config.Enabled == false, "P1 must remain disabled by default")
assert(Config.StudioOnly == true, "P1 must remain Studio-only")
assert(Config.Tuning.BranchReachStuds == 6, "P1 must preserve the six-stud interaction envelope")
assert(Config.Tuning.SpringStrength > 0 and Config.Tuning.Damping > 0, "P1 spring tuning must be positive")

local zero = P1.computeTension({ PullDistanceStuds = 0, TwistDegrees = 0 }, Config.Tuning)
assert(zero.Value == 0 and zero.Dominant == "None", "zero input must be tension-free")

local pull = P1.computeTension({ PullDistanceStuds = 2.5, TwistDegrees = 0 }, Config.Tuning)
assert(pull.Dominant == "Pull", "pull-only input must identify Pull as dominant")
assert(pull.Value == Config.Tuning.PullContribution, "pull input must reach its configured contribution")

local twist = P1.computeTension({ PullDistanceStuds = 0, TwistDegrees = 70 }, Config.Tuning)
assert(twist.Dominant == "Twist", "twist-only input must identify Twist as dominant")
assert(twist.Value == Config.Tuning.TwistContribution, "twist input must reach its configured contribution")

local combined = P1.computeTension({ PullDistanceStuds = 1.75, TwistDegrees = 65 }, Config.Tuning)
assert(combined.Dominant == "Combined", "balanced pull and twist must report Combined")
assert(combined.Value >= Config.Tuning.DetachThreshold, "combined load must be able to cross the detach threshold")
assert(combined.Value <= 1, "tension must stay bounded")

local invalid, invalidReason = P1.validateTensionInput({ PullDistanceStuds = math.huge, TwistDegrees = 0 })
assert(invalid == false and invalidReason == "InvalidPullDistanceStuds", "non-finite input must be rejected")

local earlyRelease = P1.newSession(Config.Tuning)
assert(earlyRelease.beginGrip(5.9, true).Accepted, "in-range attached Ruby must be grippable")
local partial = earlyRelease.updateGrip({ PullDistanceStuds = 1, TwistDegrees = 0 })
assert(partial.Accepted and partial.State == "Gripped", "insufficient pull must keep the Ruby gripped")
assert(partial.Events[1].Name == "P1PeakTension", "peak tension telemetry is missing")
local released = earlyRelease.releaseGrip()
assert(released.Accepted and released.State == "Attached", "early release must leave the Ruby attached")
assert(released.Events[1].Name == "P1GripReleasedAttached", "early release telemetry is missing")

local invalidGrip = P1.newSession(Config.Tuning)
local tooFar = invalidGrip.beginGrip(6.01, true)
assert(not tooFar.Accepted and tooFar.Reason == "OutOfReach", "server reach boundary must be enforced")
local detachedBranch = invalidGrip.beginGrip(2, false)
assert(not detachedBranch.Accepted and detachedBranch.Reason == "BranchNotAttached", "attached-state validation must be enforced")

local caught = P1.newSession(Config.Tuning)
assert(caught.beginGrip(2, true).Accepted, "caught path grip failed")
local detached = caught.updateGrip({ PullDistanceStuds = 2.5, TwistDegrees = 0 })
assert(detached.Accepted and detached.State == "DetachedAirborne", "authoritative pull must detach the Ruby")
assert(detached.Events[#detached.Events].Name == "P1Detached", "detach telemetry is missing")
assert(detached.ReleaseSpeed ~= nil and detached.ReleaseSpeed <= Config.Tuning.MaxReleaseVelocity, "release velocity must be bounded")
local caughtRuby = caught.catchRuby()
assert(caughtRuby.Accepted and caughtRuby.State == "Held", "airborne Ruby must be catchable")
assert(caughtRuby.Events[1].Name == "P1CaughtBeforeGround", "catch telemetry is missing")
local served = caught.serveRuby()
assert(served.Accepted and served.State == "Served", "held Ruby must have a serve seam")
assert(served.Events[1].Name == "P1Served", "serve telemetry is missing")
local duplicateServe = caught.serveRuby()
assert(not duplicateServe.Accepted and duplicateServe.Reason == "RubyNotHeld", "a served Ruby must not reward twice")

local recovered = P1.newSession(Config.Tuning)
recovered.beginGrip(2, true)
recovered.updateGrip({ PullDistanceStuds = 2.5, TwistDegrees = 0 })
local dropped = recovered.dropRuby()
assert(dropped.Accepted and dropped.State == "RecoverableGround", "missed catch must create a recoverable ground state")
assert(dropped.Events[1].Name == "P1Dropped", "drop telemetry is missing")
local outOfReach = recovered.recoverRuby(Config.Tuning.CatchForgivenessStuds + 0.01, true)
assert(not outOfReach.Accepted and outOfReach.Reason == "RecoveryOutOfReach", "recovery reach must be server-validated")
local recoveredRuby = recovered.recoverRuby(Config.Tuning.CatchForgivenessStuds, true)
assert(recoveredRuby.Accepted and recoveredRuby.State == "Held", "settled Ruby must be recoverable")
assert(recoveredRuby.Events[1].Name == "P1Recovered", "recovery telemetry is missing")

local returned = P1.newSession(Config.Tuning)
returned.beginGrip(2, true)
returned.updateGrip({ PullDistanceStuds = 2.5, TwistDegrees = 0 })
returned.dropRuby()
assert(not returned.recoverOutOfBounds(false, true).Accepted, "moving Ruby must not use last-resort recovery")
assert(not returned.recoverOutOfBounds(true, false).Accepted, "reachable Ruby must not use last-resort recovery")
local returnedResult = returned.recoverOutOfBounds(true, true)
assert(returnedResult.Accepted and returnedResult.State == "Attached", "settled unreachable Ruby must return to source")
assert(returnedResult.Events[1].Name == "P1OutOfBoundsRecovered", "out-of-bounds telemetry is missing")

local abandoned = P1.newSession(Config.Tuning)
abandoned.beginGrip(2, true)
local abandonedResult = abandoned.abandon("TestCleanup")
assert(abandonedResult.Accepted and abandonedResult.State == "Abandoned", "session abandonment must be explicit")
assert(abandonedResult.Events[1].Name == "P1Abandoned", "abandonment telemetry is missing")

print("Pipi Labu P1 springy-branch contract passed disabled flag, tension, authority, recovery, serve, and telemetry cases")
